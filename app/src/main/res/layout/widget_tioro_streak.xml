<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_streak_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Flame Icon Emoji / Text -->
    <TextView
        android:id="@+id/widget_streak_flame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥"
        android:textSize="36sp" />

    <!-- Big Streak Number -->
    <TextView
        android:id="@+id/widget_streak_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Label: "días de racha" / "days streak" -->
    <TextView
        android:id="@+id/widget_streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/streak_plural_days"
        android:textColor="#A0A0A0"
        android:textSize="11sp" />

    <!-- Indicator status for today: saved or unsaved -->
    <TextView
        android:id="@+id/widget_streak_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_streak_today_unsaved"
        android:textColor="#E5C07B"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
